{"id":"8f38a40f-be7e-4ef4-9c6e-52c197a239bc","name":"PoE2 core currencies","author":"ProgrammerAD","icon":"data:image/png;base64,","description":"A pack of \"Path of Exile 2\" game core currency items.\nBased on \"https://pathofexile2.wiki.fextralife.com/Currencies\"","questions":["What has better effect?","What you prefer to drop?","What has better icon?"],"items":[{"id":"e20db025-485b-40ab-8039-8c5ff4f55141","name":"Arcanist's Etcher","icon":"data:image/png;base64,","description":"Improves the quality of a wand, staff or sceptre."},{"id":"6e973245-e1c0-485c-9373-9106a3337b46","name":"Armourer's Scrap","icon":"data:image/png;base64,","description":"Improves the quality of an armour"},{"id":"39aa2b3b-4174-42f1-819d-34ccc4b9065b","name":"Artificer's Orb","icon":"data:image/png;base64,","description":"Adds a Rune Socket to a Martial Weapon or Armour"},{"id":"edffac36-e3ab-485a-a580-bb7fa8af4306","name":"Blacksmith's Whetstone","icon":"data:image/png;base64,","description":"Improves the quality of a martial weapon"},{"id":"8a23e0e7-b4c6-4615-8cf5-8033fbc9b1c0","name":"Chaos Orb","icon":"data:image/png;base64,","description":"Removes a random modifier and augments a Rare item with a new random modifier"},{"id":"907015bf-e036-4eeb-b339-f30a700862cf","name":"Divine Orb","icon":"data:image/png;base64,","description":"Randomises the numeric values of modifiers on an item"},{"id":"fc4de885-6a14-494f-8772-a671693d4525","name":"Exalted Orb","icon":"data:image/png;base64,","description":"Augments a Rare item with a new random modifier"},{"id":"481d3a64-5455-4ea8-8728-233b6ee23b01","name":"Fracturing Orb","icon":"data:image/png;base64,","description":"Fracture a random modifier on a rare item with at least 4 modifiers, locking it in place."},{"id":"5e7adcd6-399a-4cc5-8f65-4358d187f082","name":"Gemcutter's Prism","icon":"data:image/png;base64,","description":"Improves the quality of a skill gem"},{"id":"81652fb9-764f-4d88-b3e3-5812534a1c0b","name":"Glassblower's Bauble","icon":"data:image/png;base64,","description":"Improves the quality of a flask"},{"id":"e2ebdeb7-5c78-4aca-9817-b216c287e366","name":"Greater Jeweller's Orb","icon":"data:image/png;base64,","description":"Sets a Skill Gem to have 4 Support Gem Sockets"},{"id":"6a77d364-4958-4176-b732-727798d95366","name":"Lesser Jeweller's Orb","icon":"data:image/png;base64,","description":"Sets a Skill Gem to have 3 Support Gem Sockets"},{"id":"7f8bd6f1-10e6-4cae-85e4-7e8f1ba45d99","name":"Mirror of Kalandra","icon":"data:image/png;base64,","description":"Creates a Mirrored copy of an item"},{"id":"22cf91e8-61c7-47ac-b327-04ae3ea21925","name":"Orb of Alchemy","icon":"data:image/png;base64,","description":"Upgrades a Normal item to a Rare item with 4 modifiers"},{"id":"eb884479-e586-4b35-ab0a-36ca1c9a52cc","name":"Orb of Annulment","icon":"data:image/png;base64,","description":"Removes a random modifier from an item"},{"id":"be3e6be1-7bc4-440d-8e74-44b7f2d33e97","name":"Orb of Augmentation","icon":"data:image/png;base64,","description":"Augments a Magic item with a new random modifier"},{"id":"8af19f87-4e58-43ee-8328-07078b8728e6","name":"Orb of Chance","icon":"data:image/png;base64,","description":"Unpredictably either upgrades a Normal item to Unique rarity or destroys it"},{"id":"4396d943-aab5-4884-b9f4-ca14897704eb","name":"Orb of Transmutation","icon":"data:image/png;base64,","description":"Upgrades a Normal item to a Magic item with 1 modifier"},{"id":"dfd9ffa1-916b-4571-b951-8b8eb8b7237c","name":"Perfect Jeweller's Orb","icon":"data:image/png;base64,","description":"Sets a Skill Gem to have 5 Support Gem Sockets"},{"id":"734e6064-62f8-4276-bfbf-a8d2c1317e8f","name":"Regal Orb","icon":"data:image/png;base64,","description":"Upgrades a Magic item to a Rare item, adding 1 modifier"},{"id":"b6452492-7af2-4b80-b990-dd3a0bb2be8f","name":"Scroll of Wisdom","icon":"data:image/png;base64,","description":"Identifies an item"},{"id":"c6229922-3ec9-4a20-b104-79fa2a2eb82d","name":"Vaal Orb","icon":"data:image/png;base64,","description":"Modifies an item unpredictably and Corrupts it"}]}